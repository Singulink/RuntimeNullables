<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds small projects that use the RuntimeNullables package built from this repository, with the newest .NET SDK of the dotnet on PATH. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Building it creates the package (GeneratePackageOnBuild). Its informational version is the package version. -->
    <ProjectReference Include="..\..\Source\RuntimeNullables\RuntimeNullables.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PackageDirectory" Value="$(MSBuildThisFileDirectory)..\..\Source\RuntimeNullables\bin\$(Configuration)\" />
  </ItemGroup>

</Project>
