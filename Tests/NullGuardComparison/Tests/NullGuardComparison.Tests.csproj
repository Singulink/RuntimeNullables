<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- The name of the Runtime Nullables tests, which TestAssemblyNonPublic makes its internals visible to. -->
    <AssemblyName>RuntimeNullables.Tests</AssemblyName>
    <RootNamespace>RuntimeNullables.Tests</RootNamespace>

    <ChecksDirectory>$(RepositoryDirectory)Tests\RuntimeNullables.Tests\Checks\</ChecksDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- The behavior tests, except the ones for the default settings and throw helpers, whose test assemblies only make sense with Runtime Nullables. -->
    <Compile Include="$(ChecksDirectory)*.cs" Exclude="$(ChecksDirectory)DefaultSettingsTests.cs;$(ChecksDirectory)UsesThrowHelpersTests.cs" />
    <Compile Include="NullCheckAssert.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestAssembly\TestAssembly.csproj" />
    <ProjectReference Include="..\TestAssemblyNonPublic\TestAssemblyNonPublic.csproj" />
    <ProjectReference Include="..\TestAssemblyPointers\TestAssemblyPointers.csproj" />
    <ProjectReference Include="..\TestAssemblyRuntimeAsync\TestAssemblyRuntimeAsync.csproj" />
  </ItemGroup>

</Project>
